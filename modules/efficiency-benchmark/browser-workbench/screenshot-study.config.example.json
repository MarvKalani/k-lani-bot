{
  "codexExecutable": "/absolute/path/to/current/codex",
  "nodeExecutable": "/absolute/path/to/k-lani-bot-node",
  "chromeExecutable": "/absolute/path/to/google-chrome",
  "imageLibrary": "/absolute/path/to/sharp/dist/index.mjs",
  "scrotLauncher": "/absolute/path/to/scrot",
  "authoringDirectory": "/absolute/path/to/prior/private/authoring",
  "model": "gpt-6-luna",
  "reasoningEffort": "medium",
  "timeoutMs": 300000,
  "repetitions": 3,
  "maximumAttempts": 1,
  "resetPointer": true,
  "routes": ["pixel-original", "pixel-cursor", "pixel-half", "pixel-palette", "pixel-sparse"],
  "variants": {
    "pixel-original": {"scale": 1, "palette": false, "cursor": false},
    "pixel-cursor": {"scale": 1, "palette": false, "cursor": true},
    "pixel-half": {"scale": 0.5, "palette": false, "cursor": false},
    "pixel-palette": {"scale": 1, "palette": true, "cursor": false},
    "pixel-sparse": {"scale": 1, "palette": false, "cursor": false, "sparse": true}
  }
}
