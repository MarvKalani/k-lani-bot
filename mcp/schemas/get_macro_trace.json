{
  "name": "get_macro_trace",
  "description": "Reads a bounded page from this principal\u0027s opted-in private macro trace.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "run_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "node": {
        "type": "string"
      }
    },
    "required": [
      "run_id"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
