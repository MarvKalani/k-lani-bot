<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetFrameworks;TargetFramework;RuntimeIdentifier;SelfContained">
  <!-- Analyzers are loaded by the compiler, which requires netstandard2.0. The packages are build-time only and do not ship.
       build.sh sets the platform's framework and runtime globally; restore would otherwise apply them here as well. -->
  <PropertyGroup>
    <TargetFrameworks />
    <TargetFramework>netstandard2.0</TargetFramework>
    <RuntimeIdentifier />
    <SelfContained>false</SelfContained>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 asks for release-tracking markdown files; the rules are documented in AGENTS.md instead. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
