FROM mcr.microsoft.com/dotnet/sdk:10.0-noble@sha256:35d40304542c8689331f8cab17c65926cdf48fe711e289321d71924b230a7d29 AS build
WORKDIR /source
COPY contracts /source/contracts
COPY Directory.Build.props /source/Directory.Build.props
COPY global.json /source/global.json
COPY tools/CodeStandardAnalyzer /source/tools/CodeStandardAnalyzer
COPY assets/branding /source/assets/branding
COPY src/k-lani-bot-node /source/src/k-lani-bot-node
RUN dotnet publish src/k-lani-bot-node/k-lani-bot-node.csproj -c Release -f net10.0 -r linux-x64 \
    -p:TargetFrameworks=net10.0 -o /publish -warnaserror --nologo

FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    xvfb openbox xdotool xclip scrot wmctrl dbus-x11 libglib2.0-bin at-spi2-core libatspi2.0-0 libatk-bridge2.0-0 \
    libgtk-3-0t64 mousepad xfonts-base fonts-dejavu-core libicu74 libssl3t64 zlib1g libstdc++6 libgssapi-krb5-2 \
    && dpkg-query -W > /usr/share/k-lani-bot-system-packages.txt \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home k-lani-bot
COPY --from=build /publish/k-lani-bot-node /app/k-lani-bot-node
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh /app/k-lani-bot-node
ENV DISPLAY=:99 NO_AT_BRIDGE=0 GTK_MODULES=atk-bridge \
    XDG_CONFIG_HOME=/tmp/config XDG_CACHE_HOME=/tmp/cache XDG_DATA_HOME=/tmp/data \
    DOTNET_BUNDLE_EXTRACT_BASE_DIR=/tmp/dotnet
WORKDIR /workspace
USER 10001:10001
# No network port, Docker socket, host X11 socket, clipboard or transport key is exposed.
ENTRYPOINT ["/entrypoint.sh"]
