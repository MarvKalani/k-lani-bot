{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "k-lani-bot proposed lockfile v1",
  "description": "Proposed contract; not an active product/registry admission mechanism.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ]
    },
    "resolved": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "approval_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dependencies": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "required": [
          "id",
          "version",
          "sha256",
          "approval_sha256",
          "dependencies"
        ]
      }
    },
    "catalog_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "revocation_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "generation_id",
    "root",
    "resolved",
    "catalog_sequence",
    "revocation_sequence",
    "policy_sha256"
  ]
}
