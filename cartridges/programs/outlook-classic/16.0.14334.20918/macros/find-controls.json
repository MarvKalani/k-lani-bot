{
  "version": 2,
  "name": "outlook_find_controls",
  "description": "Find exposed controls by name, automation ID or role without activating them.",
  "parameters": [
    {
      "name": "pid",
      "type": "integer",
      "description": "Bound by cartridge_info.",
      "required": true
    },
    {
      "name": "window_title",
      "type": "string",
      "description": "",
      "required": true
    },
    {
      "name": "name",
      "type": "string",
      "description": "",
      "required": false,
      "default": ""
    },
    {
      "name": "auto_id",
      "type": "string",
      "description": "",
      "required": false,
      "default": ""
    },
    {
      "name": "role",
      "type": "string",
      "description": "",
      "required": false,
      "default": ""
    }
  ],
  "steps": [
    {
      "action": "find_elements",
      "args": {
        "pid": "{{pid}}",
        "title": "{{window_title}}",
        "name": "{{name}}",
        "auto_id": "{{auto_id}}",
        "role": "{{role}}",
        "limit": 20
      }
    }
  ],
  "postconditions": [],
  "sha256": ""
}
