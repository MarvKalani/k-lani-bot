{
  "version": 2,
  "name": "outlook_mailboxes",
  "description": "Read one page of mailbox roots and their stable IDs.",
  "parameters": [
    {
      "name": "pid",
      "type": "integer",
      "description": "Bound by cartridge_info.",
      "required": true
    },
    {
      "name": "offset",
      "type": "integer",
      "description": "",
      "required": false,
      "default": 0
    },
    {
      "name": "limit",
      "type": "integer",
      "description": "",
      "required": false,
      "default": 20
    }
  ],
  "steps": [
    {
      "action": "inspect_application",
      "args": {
        "pid": "{{pid}}",
        "area": "Folders",
        "offset": "{{offset}}",
        "limit": "{{limit}}"
      }
    }
  ],
  "postconditions": [],
  "sha256": ""
}
