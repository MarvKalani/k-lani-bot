{
  "version": 2,
  "name": "outlook_activate_control",
  "description": "Activate exactly one exposed Outlook control. Stops on missing or ambiguous targets; verify the application result separately.",
  "parameters": [
    {
      "name": "pid",
      "type": "integer",
      "description": "Observed OUTLOOK process identifier.",
      "required": true
    },
    {
      "name": "window_title",
      "type": "string",
      "description": "",
      "required": true
    },
    {
      "name": "name",
      "type": "string",
      "description": "",
      "required": false,
      "default": ""
    },
    {
      "name": "auto_id",
      "type": "string",
      "description": "",
      "required": false,
      "default": ""
    },
    {
      "name": "role",
      "type": "string",
      "description": "",
      "required": false,
      "default": "Button"
    }
  ],
  "steps": [
    {
      "action": "focus_window",
      "args": {
        "pid": "{{pid}}",
        "title": "{{window_title}}"
      }
    },
    {
      "action": "find_elements",
      "args": {
        "pid": "{{pid}}",
        "title": "{{window_title}}",
        "name": "{{name}}",
        "auto_id": "{{auto_id}}",
        "role": "{{role}}",
        "visible": true,
        "enabled": true,
        "limit": 2
      },
      "capture": "control",
      "expect_count": 1
    },
    {
      "action": "click_element",
      "args": {
        "id": "{{control.matches.0.Id}}"
      }
    }
  ],
  "postconditions": [],
  "sha256": ""
}
